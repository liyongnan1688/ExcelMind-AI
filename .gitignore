# ==============================================================================
# Lee-Excel 项目 Git 忽略规则 (.gitignore)
# 目标：发布至 GitHub 开源/团队共享，保障密钥安全、防污染，并确保开箱即用体验
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 敏感信息与本地密钥防护 (严防个人 API Key / Token 泄露至公网)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
local_config.json
config.local.json
api_key.txt
*.key
*.pem

# ------------------------------------------------------------------------------
# 2. Node.js 与前端构建依赖 (web/ 目录生态)
# ------------------------------------------------------------------------------
node_modules/
web/node_modules/
web/dist/
web/.svelte-kit/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 3. 编辑器、IDE 与操作系统专属临时文件
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ------------------------------------------------------------------------------
# 4. Office 与 Excel 临时加锁文件 (避免测试或打开工作簿时产生锁定文件污染 Git)
# ------------------------------------------------------------------------------
~$*.xlsx
~$*.xls
~$*.xlsm
~$*.xlam
*.tmp

# ------------------------------------------------------------------------------
# 5. C# 编译调试与测试生成物防污染 (严格遵守 AGENTS.md 规约)
# ------------------------------------------------------------------------------
# 严禁在 bin/ 或根目录下留存测试可执行程序、临时日志、调试 dump 与临时工作簿
bin/*.exe
bin/*.log
bin/*.xlsx
bin/*.pdb
*.dmp
*.dump

# ------------------------------------------------------------------------------
# 6. 本项目历史备份与测试隔离目录 (保留原有治理基线)
# ------------------------------------------------------------------------------
# 自动化测试完全清空的临时隔离测试目录（已确认零文件留存）
bin/scratch/
scratch/entry_test_isolated/
scratch/repro_select_case/
scratch/snap_verify_isolated/
scratch/state_test_isolated/
scratch/scratch/

# 治理清理专用本地备份目录（固定命名，无模糊通配）
.backup_cleanup_batch1_20261001/
.backup_cleanup_batch2_20261001/
.backups/

# 长期测试与调试生成物隔离目录（由 clean_artifacts.ps1 管理，包含 release 打包产物）
.artifacts/
